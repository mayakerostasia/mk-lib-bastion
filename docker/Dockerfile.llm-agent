# Build stage
FROM rust:alpine as builder

RUN apk add --no-cache musl-dev openssl-dev openssl-libs-static pkgconfig

WORKDIR /build
COPY . .

# Build the LLM agent binary (placeholder - you'll need to create this)
# For now, this shows the pattern
RUN cargo build --release --bin llm-agent || \
    echo "Note: llm-agent binary not found. You'll need to create it in simian-llm/src/bin/llm-agent.rs"

# Runtime stage
FROM alpine:latest

RUN apk add --no-cache ca-certificates

# Copy binary if it exists
COPY --from=builder /build/target/release/llm-agent /usr/local/bin/llm-agent 2>/dev/null || true

# Environment variables will be set by docker-compose
ENV RUST_LOG=info

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD ps aux | grep llm-agent || exit 1

# Entrypoint
CMD ["/usr/local/bin/llm-agent"]
